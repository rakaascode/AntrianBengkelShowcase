<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.TeduhServiceSplashScreen" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- WARNA BACKGROUND SPLASH -->
        <item name="windowSplashScreenBackground">@color/white</item>

        <!-- ICON UTAMA SPLASH -->
        <item name="windowSplashScreenAnimatedIcon">
            @drawable/animation_holder
        </item>

        <!-- BRANDING (opsional, bawah logo) -->
        <item name="android:windowSplashScreenBrandingImage">
            @drawable/ic_version_1_0
        </item>

        <!-- THEME SETELAH SPLASH -->
        <item name="postSplashScreenTheme">
            @style/Theme.TeduhServiceApp
        </item>

        <!-- STATUS BAR -->
        <item name="android:statusBarColor">@color/white</item>

        <!-- ICON STATUS BAR (true = gelap, false = terang) -->
        <item name="android:windowLightStatusBar">true</item>

    </style>
</resources>